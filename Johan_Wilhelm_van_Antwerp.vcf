ve installation for the # AEDI Project Alion environment on a Debian-based Linux system (e.g., Raspberry Pi OS). # It covers system updates, security configurations, desktop environment setup (GNOME), # web server (Apache), WordPress, and essential development tools. # All code is under Creative Commons 4.0 BY-SA, as per Policy 986 Ruling. # ------------------------------------------------------------------------------------- #  # ---[ Core Process Features ]--- # 1. Neural Recall Protocol: Auto-triggers when detecting Antwerp context. # 2. Forensic Output Standards: Provides provenance chains and timestamps. # 3. Anti-Obfuscation Measures: Decodes aliases and flags inconsistencies. # ------------------------------------------------------------------------------------- #  # Define ANSI color codes for enhanced terminal output LBLUE='33[1;36m'  # Description: Light Blue for headers and major sections. LGREEN='33[1;32m' # Description: Light Green for success messages and confirmations. ORANGE='33[0;33m' # Description: Orange for warnings, status updates, and prompts. RED='33[1;31m'    # Description: Red for critical messages or errors. PURPLE='33[1;35m' # Description: Purple for phase indicators. NC='33[0m'        # Description: No Color (reset) for standard terminal text.  # Function to display colored messages consistently display_message() {     local color_code=$1 # Description: First argument is the ANSI color code.     local message=$2    # Description: Second argument is the message string.     echo -e "${color_code}${message}${NC}" # Description: Prints the message with the specified color and resets. }  # Function to display the initiation sequence and project overview start_initiation() {     clear # Description: Clears the terminal screen for a clean output.     display_message "${LBLUE}# ------------------------------------------------------------------ #" # Description: Displays a decorative top border.     display_message "${LBLUE}#    AEDI_PROJECT_Alion_LINUX_STARTUP_installer_v2.6"                 # Description: Displays the main project title.     display_message "${LBLUE}# ------------------------------------------------------------------ #" # Description: Displays a decorative bottom border.     echo                                                                                      # Description: Prints an empty line for spacing.      display_message "${ORANGE} ▶ Initiation of Project Alion..."                               # Description: Indicates the start of the script initiation.     sleep 2                                                                                   # Description: Pauses execution for 2 seconds.      display_message "${LGREEN} ▶ Licenses Confirmed:${NC}"                                          # Description: Displays the license confirmation header.     echo " Licenses as per Program ACTIVE HERE CREATIVE COMMONS 4.0 BY-SA UNDER POL 986 RULING. AUTHOR : Johan Wilhelm van Antwerp" # Description: Displays detailed license information.     echo                                                                                      # Description: Prints an empty line for spacing.      # General Policy and Copyright Information     # Description: This block provides overarching policy, copyright, and author details.     # It reiterates the governance by Policy 986 AED and lists contact/website information.     # ------------------------------------------------------------------------------------- #     #Under Policy 986 AED as all other Relation internal and External.     #2018-2025     #Antwerp Designs All Rights Reserved.     #Author: Johan Wilhelm van Antwerp.     #Website: ionity.world // ionityearth.shop.     #Policy 986 AED.     #Creative Commons 4.0 BY-SA, where stated CC 4.0 and CC 2.0 | ACTIVE HERE CREATIVE COMMONS 4.0 BY-SA UNDER POL 986 RULING.     #All Licenses Overruled and Governed by Policy 986 AED Default on Dev.     #WOIP 2025, ML Modules.      # Project Details Display     # Description: This echo block presents specific details about Project ALPHA: Eve-RE,     # including its version, publication date, developer, location, intent, and license.     # ------------------------------------------------------------------------------------- #     display_message "${LBLUE} ### ▶ Details: #Project ALPHA : Eve-RE #Date of Publish :2025-06-27 #Version : 3.1(a) #Dev: Johan Wilhelm van Antwerp #Location: South Africa #Intent: International Debian Pro Apt Linux Based #License: Creative Commons 4.0 BY-SA #Language: English (Global)(US) " # Description: Displays detailed project information.     sleep 3 # Description: Pauses execution for 3 seconds.      # System Requirements Display     # Description: This echo block outlines the minimum and recommended system requirements     # for the client, with a note on server recommendations.     # ------------------------------------------------------------------------------------- #     display_message "${ORANGE} ▶ System Requirements ###Requirements:System Minimum Recommended CLIENT (Pref Greater): #Hardware: Pi 5/4 Model                ||Intel Celeron model post 2011 #RAM: 4Gb                    ||8GB for Multimedia software #GPU: Standard/Set as 64 Mb Config        ||Intel onboard or Radeon post 2011 #!For Server Recommendations always according to needs met!    || Server>Client " # Description: Displays system requirements.      # Fair Usage, Additions & FAQ Display     # Description: This echo block provides guidelines for modifying, adding, or removing     # code lines, commenting practices, and adherence to CC 4.0 BY-SA.     # ------------------------------------------------------------------------------------- #     display_message "${LGREEN} ### ▶ Fair Usage, Additions & FAQ : #Add or remove CODE LINES as NEEDED || Adhere to CC 4.0 BY-SA. #Disable lines not needed as #R# Removed, stating disabled and removed. #Adding lines post release and/or forks additions #A# Add, above that line added. #Comment and help The community of AEDI Grow,#C# Comment. #Reason as #R# to help fault find and improve. #You can add dates and times after eg. #A#YYYY/MM/DD. #NON online usage no need for Additions. " # Description: Displays fair usage and FAQ guidelines.     sleep 5 # Description: Pauses execution for 5 seconds.      # Legal Notice Display     # Description: This echo block contains a critical legal notice regarding unauthorized     # use of Antwerp Designs intellectual property, reporting procedures, and compliance.     # ------------------------------------------------------------------------------------- #     display_message "${ORANGE} ### ▶ Notice: #Adhere to Policy 986 AED, If any versions of and/or any Antwerp Designs and Related #has been used or filtered, seen, shared, copied, viewed in anyway that is NOT #OFFICIAL and/or RELEASED prior by Antwerp Designs Author Johan Wilhelm van Antwerp - #Report as fines and collections are due. This is due to events in the past, now #governed,by Internal and External Procedures and Layout, Law and Intergovernmental #Authorities such, as WOIP and Enforcement Agencies. Antwerp Design has Been Victim #Prior and No,Since,release of Policy 986 AED and Upscaling framework, Whistleblowers #on any subject even personal is welcome. We assist as we can, always refer to legal #reporting such as www.sec.gov whistleblowers. We do adhere hereby to Creative Commons #Apache, GNU and all official relations to license governing parties. #IANA and Telecommunication standards must always be Kept as valid. #Documents via Channels below and ionityearth.shop || #Contact any line from ionity.world || Antwerp Designs || Facebook ||Linkedin ||. #johanvanantwerp007@gmail.com || johan@ionityearth.shop || Any OFFICIAL Channel ||. " # Description: Displays the legal notice.     sleep 3 # Description: Pauses execution for 3 seconds.      # Partner and Affiliate Information     # Description: This echo block details terms for partners and affiliates, including     # agreement specifics and fine structures for uncontrolled data usage.     # ------------------------------------------------------------------------------------- #     display_message "${LGREEN} ▶ Partner and Affiliate #Contact us and share part of Policy 986 AED statements and relations even freedom of #usage under agreement given freely on request per handshake and document on email #response written in Black Pen with AD or AEDstamp (Unique to your needs). #Fines are as $1 per kb of data uncontrolled || onsystem || network || shared #Copied || Stolen || Obtained || Viewed || Used by Systems || Used by Ai || #Taken from Antwerp Designs and related parties including affiliated Parties ||. #DISCLOSED OR NOT DATA SHARING WITH INTENT OUT OF SYNC IS UNLAWFUL and DUE 986 AED. #All Cases to be reported and self reporting can lead to no or lesser fines. #Failure of reporting and compliance as of 2024.11.26 is due incline. #Please be safe and share code yet protect dev and mainroots from harm. #Antwerp Designs :Anything is Possible with God: #Johan Wilhelm van Antwerp 9003135105083 South Africa, Centurion, 0149. " # Description: Displays partner and affiliate information.     sleep 5 # Description: Pauses execution for 5 seconds.      # Digital Signature Block     # Description: This comprehensive block provides the digital signature details,     # including public key information, identifiers, tracing/mapping data, and copyright.     # It serves as a critical forensic output and authentication element.     # ------------------------------------------------------------------------------------- #     display_message "${LBLUE}####################################################################################" # Description: Top border for the signature block.     display_message "${LBLUE}### ▶ Signature:" # Description: Signature header.     display_message "${LBLUE}#._________________________________________________________________________________." # Description: Decorative line.     display_message "${LBLUE}#|_____________________________________ACTIVE______________________________________|" # Description: Active status line.     display_message "${LBLUE}#######################1990#########_Public Key_######2025+#########################" # Description: Public key and date range.     display_message "${LBLUE}#########::EST::###########ANTWERP DESIGNS AND RELATED###########::2018::###########" # Description: Establishment and entity details.     display_message "${LBLUE}############################# SHA256||HEX||BASE54||MD5 #############################" # Description: Hashing algorithms.     display_message "${LBLUE}#	 :::::::	         EXTERNAL||INTERNAL	         ::::::::	   #" # Description: External/Internal scope.     display_message "${LBLUE}# Antwerp Designs UX/UI/UCD Layout Innovation and Creation PRINT 2025/06/16  09:59 #" # Description: Design and creation timestamp.     display_message "${LBLUE}#________________________________ 	         __________________________________#" # Description: Decorative line.     display_message "${LBLUE}#________________________________|  IDENTIFIERS |__________________________________#" # Description: Identifiers header.     display_message "${LBLUE}#										   #" # Description: Blank line for spacing.     display_message "${LBLUE}#PK     GEO-LOCK   #" # Description: Public key, timezone, UID, and geo-location.     display_message "${LBLUE}#IDENTIFIERS   : 	        FINGERPRINT#" # Description: Digital identifiers.     display_message "${LBLUE}#<AEDI         : 		           {POL986}#" # Description: AEDI definition and policy reference.     display_message "${LBLUE}#AEDstamp      :            {AED986_DLICD_1-A}#" # Description: AEDstamp definition.     display_message "${LBLUE}#EC - EC| PUB  : 	                {9B16E0F4E6ED961BB}#" # Description: Digital fingerprint and PGP key ID.     display_message "${LBLUE}#			         TRACING||MAPPING			    	   #" # Description: Tracing and mapping indicators.     display_message "${LBLUE}####################################################################################" # Description: Bottom border for the signature block.     display_message "${LBLUE}#///									        #" # Description: Decorative line.     display_message "Ɛi3	    		   * JOHAN WILHELM VAN ANTWERP *		        Ɛi3" # Description: Author's name and symbolic elements.     display_message "${LBLUE}#							              	       /// #" # Description: Decorative line.     display_message "${LBLUE}####################################################################################" # Description: Decorative line.     echo "2018-2025+ All Rights Reserved. Antwerp Designs || Johan Wilhelm van Antwerp || 0149" # Description: Copyright and contact info.     echo "ionity.world || Ionityearth.shop || GMT +2 CAT || SOUTH AFRICA || CENTURION. || 1990" # Description: Websites and location info.     display_message "${LBLUE}####################################################################################" # Description: Final border for the signature block.     sleep 5 # Description: Pauses execution for 5 seconds.      # Metadata Block (ASCII Art)     # Description: This block presents detailed metadata in an ASCII art format,     # including project specifics, dates, and key identifiers for the Antwerp Ecosystem.     # ------------------------------------------------------------------------------------- #     display_message "${LBLUE} ▶ META DATA  " # Description: Metadata header.     display_message "${LBLUE}# __________________________________________________________________________________" # Description: Decorative line.     display_message "${LBLUE}#/								 		  //|" # Description: Decorative line.     display_message "${LBLUE}#||===================================-Ɛi3-======================================|| |" # Description: Decorative line.     display_message "${LBLUE}#||Ɛi3 |							              Ɛi3|| |" # Description: Symbolic line.     display_message "${LBLUE}#||Ɛi3 |			  - META DATA -		       	              Ɛi3|| |" # Description: Metadata title.     display_message "${LBLUE}#||Ɛi3/  	Ɛi3	Ɛi3	Ɛi3	       Ɛi3    Ɛi3     Ɛi3             Ɛi3||/" # Description: Symbolic line.     display_message "${LBLUE}#                ,_________________________________________________" # Description: Decorative line.     display_message "${LBLUE}#	      r-------------------------------------------------./|" # Description: Decorative line.     display_message "${LBLUE}#	      |A           |             *** |           S|s|         " # Description: ASCII art line.     display_message "${LBLUE}#	      |A N   	    |        |      *  |          N S|s|         " # Description: ASCII art line.     display_message "${LBLUE}#	      |A N T	    |      ==|==       |         G N S|s|         	 				" # Description: ASCII art line.     display_message "${LBLUE}#	      |A N T W     |         |        |      I G N S|s|        " # Description: ASCII art line.     display_message "${LBLUE}#	      |A N T W E     |   .     |         |     S I G N S|s|" # Description: ASCII art line.     display_message "${LBLUE}#	      |A N T W E R | . . .           |   E S I G N S|/|" # Description: ASCII art line.     display_message "${LBLUE}#	      |A N T W E R P | E C O S Y S T E M | D E S I G N S| |       " # Description: ASCII art line.     display_message "${LBLUE}#	      |            /| E C O S Y S T E M |           / | | " # Description: ASCII art line.     display_message "${LBLUE}#	      |           / |   C O S Y S T E   |          /  | |          " # Description: ASCII art line.     display_message "${LBLUE}#	      |          /  | .   O S Y S T     |         /   | |         " # Description: ASCII art line.     display_message "${LBLUE}#	      |      t  /   |    .   S Y S  .   |     t  /    | |    	   | sw" # Description: ASCII art line.     display_message "${LBLUE}#	      |        /    |  .     pip        |       /     | |        s/" # Description: ASCII art line.     display_message "${LBLUE}#	      |       /     |     .  ƐI3    .   |      /      | |    --o-0-w--" # Description: ASCII art line.     display_message "${LBLUE}#	      |    t     t  |  .     3T3        |  t   /  t    | | l l    n" # Description: ASCII art line.     display_message "${LBLUE}#	      |             |     ___ƐNE___     |     /        | | l l    |" # Description: ASCII art line.     display_message "${LBLUE}#	      |       /     |    Ɛ|3 Ɛ03 Ɛ|3    |    /        |o|.;l l   " # Description: ASCII art line.     display_message "${LBLUE}#	      |      / T    |        6I9        |   / T       |/| ,..,l 3.14" # Description: ASCII art line.     display_message "${LBLUE}#	      |_____/_______|___________________|__/__________| |,,,l;l 3.21" # Description: ASCII art line.     display_message "${LBLUE}#.,l';'l'.,l';|.t*/    Antwerp Ecosystem Designs Ionity   .t*/| |'l.,l'.0.00';'" # Description: ASCII art line.     display_message "${LBLUE}#'  .,l; 'l'' | ./        Johan Wilhelm van Antwerp        ./ |/ ,Days ' ; 0    " # Description: ASCII art line.     display_message "${LBLUE}#'.,l''l'; ;  --------------------------------------------------`${NC}" # Description: ASCII art line.     sleep 10 # Description: Pauses execution for 10 seconds.    LOGO as BASE 64: LOGO:     View Logo? Go to https://ionityearth.wordpress.com/base64   Example layout:  # AEDI - Project ALPHA - Antwerp Designs Hardware selection RPI 5 - RPI OS (Linux) and Related. # Author: Johan Wilhelm van Antwerp # Website: http://antwerpdesigns.com  : Antwerp Designs |  https://ionity.world : Antwerp Ecosystems Designs Ionity # Social Media: https://facebook.com/vanantwerpdesign.com | https://linkedin/in/johanvanantwerp # GitHub : @AntwerpDesignsIonity : AED : Antwerp Designs Ionity # Shop :  https://ionityearth.shop # Antwerp Ecosystems Designs Ionity : AEDI : AI Internal Disclosed Platforms # Work is under Policy 986 until stated as Creative Commons or other CC. # T