{
  "name": "nobify-server",
  "version": "1.0.0",
  "private": true,
  "description": "Nobify — hosted backend for ESP32-S3 dual-sensor human presence detection (mmWave + WiFi CSI). REST + WebSocket + built-in AI insights.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning test/smoke.test.js",
    "gen:firmware": "node --disable-warning=ExperimentalWarning scripts/gen-firmware-config.mjs",
    "publish:firmware": "node --disable-warning=ExperimentalWarning scripts/publish-firmware.mjs",
    "sync:firmware": "node --disable-warning=ExperimentalWarning scripts/sync-release-firmware.mjs",
    "build:bundle": "node scripts/build-server-bundle.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "author": "Ionity Global (Pty) Ltd",
  "license": "MIT"
}
