# Nobify server configuration (copy to .env). All values optional.
PORT=8787
HOST=0.0.0.0

# Shared secret devices must send in the `x-ingest-key` header.
# Leave empty for open ingest (useful for local testing).
INGEST_KEY=

# Serve the ../webapp dashboard from this server ("false" to disable).
SERVE_WEBAPP=true

# CORS origin for the dashboard when hosted separately (e.g. GitHub Pages).
CORS_ORIGIN=*

# Presence "hold" window (ms) — how long a person stays "present" after the
# last detection before the area is considered clear.
PRESENCE_HOLD_MS=8000

# A device is "offline" if not seen within this many ms.
DEVICE_TIMEOUT_MS=30000
