{
  "name": "nobify-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Nobify desktop companion — system-tray notifications for human-presence alerts.",
  "type": "module",
  "bin": { "nobify-companion": "src/index.js" },
  "main": "src/index.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/notify.js",
    "build:bin": "npx -y @yao-pkg/pkg . --targets node20-win-x64,node20-macos-x64,node20-linux-x64 --output dist/nobify-companion"
  },
  "pkg": {
    "assets": ["assets/**/*"],
    "scripts": ["src/**/*.js"]
  },
  "optionalDependencies": {
    "ws": "^8.18.0",
    "node-notifier": "^10.0.1",
    "systray2": "^2.0.3",
    "yaml": "^2.5.1"
  }
}
