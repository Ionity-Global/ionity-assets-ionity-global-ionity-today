{
  "name": "find-spidy",
  "private": true,
  "version": "1.0.0",
  "description": "Find Spidy — crawl any URL and surface its public metadata. Web + Windows desktop (Electron) + mobile (Capacitor).",
  "type": "module",
  "author": "Ionity Global",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.3.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
